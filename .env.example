PORT=3001
APP_URL="http://localhost:3001"

# Identidade do listener local do Laya (P0.49).
# Defina LAYA_IDENTITY_FINGERPRINT e LAYA_IDENTITY_PUBLIC_KEY para usar o
# handshake de desafio-resposta criptográfico (modo "handshake", padrão).
# Com o Laya 0.3.20 (que não expõe /v1/identity), use LAYA_IDENTITY_MODE=health
# para desbloquear o fluxo V3 com prova via health do serviço loopback.
LAYA_IDENTITY_MODE=health
LAYA_IDENTITY_FINGERPRINT=
LAYA_IDENTITY_PUBLIC_KEY=
